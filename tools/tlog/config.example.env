# Copy to ~/.config/tlog/config.env and fill in your values.
# Any setting can also be overridden by an environment variable of the same name.

# --- required ---------------------------------------------------------------
TLOG_ORG=https://dev.azure.com/your-org
TLOG_PROJECT=Your Project
TLOG_TEAM=Your Team
# Area path for new tasks (backslash-separated, as shown in Azure DevOps)
TLOG_AREA=Your Project\Your Area
# The Azure DevOps account your tasks are assigned to
TLOG_USER=you@example.com

# --- optional ---------------------------------------------------------------
# Used in daily idle task titles: "<TLOG_NAME> - 29 Oct 2026" (default: part of TLOG_USER before @)
TLOG_NAME=Your Name
# Hours you log per day; the reminder fires when today is below this (default 8)
TLOG_DAILY=8
# Days the reminder runs, systemd syntax; ranges can't wrap past Sunday (e.g. Sun,Mon..Thu)
TLOG_WORKDAYS=Mon..Fri
# Activity values used by your process
TLOG_DEV_ACTIVITY=Development
TLOG_IDLE_ACTIVITY=Idle
# Text in the title of the sprint story that idle tasks go under
TLOG_IDLE_STORY=Capacity
# If your process requires an extra field on idle tasks, name it and its value here
TLOG_IDLE_REASON_FIELD=
TLOG_IDLE_REASON=
